module ml.webnn.mojom;

import "components/ml/mojom/webnn_graph.mojom";

// Represents the `MLContext` object in the WebIDL definition that is a global
// state of neural network compute workload and execution processes.
[Stable]
interface Context {
  // Create a graph to compile and compute with system framework. The MojoHandle
  // of message pipe can be used to identify the Graph in server side for
  // interoperating with WebGPU.
  CreateGraph@0() => (pending_remote<Graph>? remote);
};
