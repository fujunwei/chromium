module ml.webnn.mojom;

import "components/ml/webnn/mojom/graph.mojom";

// Represents a context instance. The user can use its `Compute` interface to do
// inferences.
// Corresponds to the `MLContext` object in the WebIDL definition.
interface Context {
  CreateGraph(uint32 result_id, uint32 context_id)
      => (pending_remote<Graph>? remote);
};
