source_set("webnn") {
  sources = [
    "webnn_context_provider_impl.cc",
    "webnn_context_provider_impl.h",
    "webnn_service.cc",
    "webnn_service.h",
  ]

  if (is_win) {
    sources += [
      "webnn_context_impl_win.cc",
      "webnn_context_impl_win.h",
      "webnn_context_provider_impl_win.cc",
      "webnn_context_provider_impl_win.h",
      "webnn_graph_impl_win.cc",
      "webnn_graph_impl_win.h",
    ]
  }

  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    "//services/webnn/public/mojom",
  ]
}

source_set("tests") {
  testonly = true
  if (is_win) {
    sources = [ "webnn_context_impl_win_unittest.cc" ]
  }

  deps = [
    ":webnn",
    "//base",
    "//base/test:test_support",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/test_support:test_utils",
    "//services/webnn/public/mojom",
    "//testing/gtest",
  ]
}
