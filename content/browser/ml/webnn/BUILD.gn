import("//build/buildflag_header.gni")
import("//content/browser/ml/webnn/dml/features.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"

  flags = [ "ENABLE_MOJO_WEBNN_IN_UTILITY_PROCESS=$build_webnn_with_directml" ]
}

source_set("lib") {
  sources = [
    "webnn_context_impl.cc",
    "webnn_context_impl.h",
    "webnn_service.cc",
    "webnn_service.h",
  ]

  if (build_webnn_with_directml) {
    if (is_win) {
      sources += [
        "dml/adapter_dml.cc",
        "dml/adapter_dml.h",
        "dml/command_queue.cc",
        "dml/command_queue.h",
        "dml/command_recorder.cc",
        "dml/command_recorder.h",
        "dml/execution_context.cc",
        "dml/execution_context.h",
        "dml/execution_resources.cc",
        "dml/execution_resources.h",
        "dml/gpgmm.cpp",
        "dml/gpgmm.h",
        "dml/gpgmm_d3d12.cpp",
        "dml/gpgmm_d3d12.h",
        "dml/graph_desc_builder.cc",
        "dml/graph_desc_builder.h",
        "dml/graph_dml_impl.cc",
        "dml/graph_dml_impl.h",
        "dml/graph_node_output.cc",
        "dml/graph_node_output.h",
        "dml/graph_tensor_desc.cc",
        "dml/graph_tensor_desc.h",
        "dml/readback_resource.cc",
        "dml/readback_resource.h",
        "dml/upload_resource.cc",
        "dml/upload_resource.h",
        "dml/utils_dml.h",
        "webnn_context_impl_win.cc",
        "webnn_context_impl_win.h",
      ]

      libs = [
        "dxgi.lib",
        "d3d12.lib",
        "directml.lib",
      ]
    }
  }

  deps = [
    "//base",
    "//components/ml/mojom",
    "//mojo/public/cpp/bindings",
  ]
}
