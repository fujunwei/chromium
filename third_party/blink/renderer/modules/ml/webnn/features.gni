import("//build/config/chrome_build.gni")
declare_args() {
  # This enables building WebNN with XNNPACK. Currently only available for
  # Linux or Windows on x64 that aligns with build_tflite_with_xnnpack.
  # See third_party/tflite/features.gni
  build_webnn_with_xnnpack = (is_win || is_linux) && current_cpu == "x64"

  # This build flag enables WebNN on ChromeOS platform to access hardware
  # acceleration, the implementation reuse Model Loader mojo interface to load
  # the WebNN graph which would be converted into a model in FlatBuffers.
  build_webnn_on_cros = is_chromeos
}
